    {
      "id": "hidden-harm-counter-engineering",
      "purpose": "Prevent connector routes from silently losing authority, provenance, evidence strength, capability, reversibility, contradictions, or continuation state.",
      "stages": [
        {
          "provider": "AspenGrove.WorkerPolicy",
          "action": "recover strongest current cursor and partition claims by authority domain",
          "state": "REQUIRED"
        },
        {
          "provider": "AspenGrove.WorkerPolicy",
          "action": "diff required capability surface against candidate route/fallback",
          "state": "REQUIRED",
          "outputs": [
            "lost_capabilities",
            "fallback_classification"
          ]
        },
        {
          "provider": "AspenGrove.WorkerPolicy",
          "action": "gate demotion, negative evidence, and projection loss before execution",
          "state": "REQUIRED",
          "outputs": [
            "authority_preservation",
            "retrieval_state",
            "lost_protected_fields"
          ]
        },
        {
          "provider": "TARGET_PROVIDER",
          "action": "capture pre-state for reversible mutation, execute, then read back owning-provider state",
          "state": "PROVIDER_NATIVE_EVIDENCE_REQUIRED"
        },
        {
          "provider": "AspenGrove.WorkerPolicy",
          "action": "compare post-state to pre-state and desired state; block silent loss or split scope instead of global demotion",
          "state": "REQUIRED"
        },
        {
          "provider": "GitHub|Supabase|Notion|Linear|ClickUp|Memory",
          "action": "persist hidden-harm receipt, unresolved slice, and strongest continuation cursor",
          "state": "READBACK_REQUIRED_WHEN_MUTATED"
        }
      ],
      "hidden_harm_states": [
        "BLOCKED_HIDDEN_HARM_DEMOTION",
        "BLOCKED_HIDDEN_HARM_PROJECTION_LOSS",
        "BLOCKED_HIDDEN_HARM_IRREVERSIBLE_WRITE",
        "DEGRADED_FALLBACK",
        "RETRIEVAL_GAP",
        "NO_MATCH_IN_PARTIAL_COVERAGE",
        "SCOPE_SPLIT_REQUIRED",
        "PRESERVE_DISTINCT_AUTHORITY"
      ],
      "invariant": "A route may be truthful yet still be rejected when it silently destroys a stronger capability or meaning."
