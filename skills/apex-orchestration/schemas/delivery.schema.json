{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.com/schemas/apex-orchestration/delivery.schema.json",
  "title": "Apex Mesh Delivery",
  "description": "Final delivery shape. SHIPPED is valid only with verified run-quality evidence and direct mission delta. See Packet 07 of apex-orchestration v1.1.0.",
  "type": "object",
  "required": [
    "mission_id",
    "status",
    "compound_artifact",
    "status_line",
    "receipt_chain_sha256",
    "memory_write_id",
    "ts"
  ],
  "additionalProperties": false,
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^mission_[a-z0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "SHIPPED",
        "BLOCKED",
        "REFUSED"
      ]
    },
    "compound_artifact": {
      "type": "object"
    },
    "status_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "receipt_chain_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "object"
        },
        "auditor": {
          "type": "object"
        },
        "refiner": {
          "type": "object"
        }
      }
    },
    "memory_write_id": {
      "type": "string",
      "pattern": "^mem_[a-z0-9]+$"
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "run_quality": {
      "type": "object",
      "required": [
        "source_coverage",
        "mission_delta",
        "durable_outputs",
        "verification",
        "next_frontier"
      ],
      "additionalProperties": false,
      "properties": {
        "source_coverage": {
          "type": "object",
          "required": [
            "scope",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "bounded",
                "partial",
                "exhaustive"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mission_delta": {
          "type": "object",
          "required": [
            "changed",
            "before",
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "changed": {
              "const": true
            },
            "before": {
              "type": "string",
              "minLength": 1
            },
            "after": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "durable_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "verified"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "next_frontier": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SHIPPED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "run_quality"
        ]
      }
    }
  ]
}
