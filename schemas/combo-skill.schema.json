{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/mega-skills/schemas/combo-skill.schema.json",
  "title": "GlacierEQ Recursive Compound Skill Integration Contract",
  "description": "A proper reusable Skill implemented as an ordered composition of atomic Skills, other validated Compound Skills, and explicit external capability references. Compound Skills add handoff structure and a compound artifact without duplicating child methods.",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "ownership",
    "maturity",
    "version",
    "path",
    "entrypoint",
    "selection",
    "members",
    "execution",
    "integration",
    "compounding"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3
    },
    "ownership": {
      "type": "string",
      "enum": [
        "glaciereq",
        "candidate"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^combo-skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^combo-skills/[a-z0-9]+(?:-[a-z0-9]+)*/COMBO\\.md$"
    },
    "selection": {
      "type": "object",
      "required": [
        "use_when",
        "do_not_use_when"
      ],
      "additionalProperties": false,
      "properties": {
        "use_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "do_not_use_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "role",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "compound-skill",
              "external-skill"
            ],
            "description": "skill = GlacierEQ atomic Skill; compound-skill = GlacierEQ recursive Compound Skill; external-skill = explicit external capability reference."
          },
          "role": {
            "type": "string",
            "minLength": 8
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "ordered_steps"
      ],
      "additionalProperties": false,
      "properties": {
        "ordered_steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "step",
              "member_id",
              "consumes",
              "produces",
              "validation"
            ],
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "member_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "consumes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "produces": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "validation": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "required": [
        "handoffs",
        "evidence_requirements",
        "risk_boundaries",
        "quality_gates",
        "state_updates"
      ],
      "additionalProperties": false,
      "properties": {
        "handoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from_member",
              "to_member",
              "required_inputs",
              "accepted_outputs",
              "failure_owner"
            ],
            "additionalProperties": false,
            "properties": {
              "from_member": {
                "type": "string"
              },
              "to_member": {
                "type": "string"
              },
              "required_inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "accepted_outputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "failure_owner": {
                "type": "string",
                "minLength": 4
              }
            }
          }
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "risk_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "quality_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "state_updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "compounding": {
      "type": "object",
      "required": [
        "inherits",
        "adds",
        "compound_artifact",
        "next_layer_ready_when"
      ],
      "additionalProperties": false,
      "properties": {
        "inherits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "adds": {
          "type": "string",
          "minLength": 20
        },
        "compound_artifact": {
          "type": "string",
          "minLength": 8
        },
        "next_layer_ready_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
