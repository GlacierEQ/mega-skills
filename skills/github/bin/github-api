#!/usr/bin/env python3
"""Call the GitHub REST API with the user's stored credential.

Usage:
  github-api GET /user
  github-api GET /repos/OWNER/REPO/issues --params '{"state":"open"}'
  github-api POST /repos/OWNER/REPO/issues --data '{"title":"Bug"}'
  echo '{"title":"Bug"}' | github-api POST /repos/OWNER/REPO/issues --stdin
  github-api GET /user --no-retry     # disable rate-limit retries

Prints {"status": <code>, "body": <json>}. Path may be given with or without
leading /. Retries on 429/5xx/rate-limit 403s (never on 401/404/422).

Auth: `gh` CLI secure store first (gh auth token), then the Postman
'Muse Keys' GitHub vars as fallback. Never stored here.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gh_common import rest_request


def main() -> int:
    ap = argparse.ArgumentParser(description="Call the GitHub REST API.")
    ap.add_argument("method", help="HTTP method, e.g. GET or POST")
    ap.add_argument("path", help="API path, e.g. /user")
    ap.add_argument("--params", help="JSON object of query parameters")
    ap.add_argument("--data", help="JSON request body")
    ap.add_argument("--stdin", action="store_true", help="Read JSON body from stdin")
    ap.add_argument("--no-retry", action="store_true", help="Disable rate-limit retries")
    ap.add_argument("--timeout", type=int, default=30, help="Request timeout seconds")
    args = ap.parse_args()

    params = json.loads(args.params) if args.params else None
    if args.stdin:
        data = json.load(sys.stdin)
    elif args.data:
        data = json.loads(args.data)
    else:
        data = None

    result = rest_request(args.method, args.path, params, data,
                          no_retry=args.no_retry, timeout=args.timeout)
    result.pop("headers", None)
    print(json.dumps(result, indent=2))
    return 0 if result["status"] < 400 else 1


if __name__ == "__main__":
    sys.exit(main())
