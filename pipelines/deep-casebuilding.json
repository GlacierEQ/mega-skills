{
  "schema_version": 1,
  "id": "deep-casebuilding",
  "description": "Durable evidence pipeline for deep casebuilding: intake validation, cryptographic hashing, anomaly scanning, Bates planning, timeline verification, PII scrubbing, hash-chained manifest emission, audio custody, court transcript compilation, alignment and diarization verification, and behavioral certification of the casebuilding skill cluster.",
  "max_parallel": 2,
  "manifest": "missions/deep-casebuilding/pipeline-execution-manifest.json",
  "stages": [
    {
      "id": "validate-intake",
      "command": ["{python}", "-c", "import json; d=json.load(open('missions/deep-casebuilding/case-intake.json')); assert d['schema_version']==1; assert d['case_number']; assert isinstance(d['evidence_roots'], list); assert d['bates_prefix']; print('intake-ok')"],
      "consumes": ["missions/deep-casebuilding/case-intake.json"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "hash-evidence-intake",
      "needs": ["validate-intake"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/sha256_digester.py", "--root", "missions/deep-casebuilding/intake", "--out", "missions/deep-casebuilding/digests.json"],
      "consumes": ["missions/deep-casebuilding/intake"],
      "produces": ["missions/deep-casebuilding/digests.json"],
      "resume_safe": true
    },
    {
      "id": "verify-hashes",
      "needs": ["hash-evidence-intake"],
      "command": ["{python}", "-c", "import json; d=json.load(open('missions/deep-casebuilding/digests.json')); assert d['algorithm']=='sha256'; assert d['chunk_size']==65536; assert d['file_count']==len(d['files']); assert all(len(f['sha256'])==64 for f in d['files']); print('hashes-ok')"],
      "consumes": ["missions/deep-casebuilding/digests.json"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "scan-anomalies",
      "needs": ["verify-hashes"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/anomaly_scanner.py", "--root", "missions/deep-casebuilding/intake", "--out", "missions/deep-casebuilding/anomalies.json"],
      "consumes": ["missions/deep-casebuilding/intake"],
      "produces": ["missions/deep-casebuilding/anomalies.json"],
      "resume_safe": true
    },
    {
      "id": "assign-bates",
      "needs": ["scan-anomalies"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/bates_stamper.py", "--manifest", "missions/deep-casebuilding/digests.json", "--prefix", "CASEBUILD", "--schema", "skills/forensic-evidence-chain-core/resources/bates_serial_schema.yaml", "--out", "missions/deep-casebuilding/bates.json"],
      "consumes": ["missions/deep-casebuilding/digests.json"],
      "produces": ["missions/deep-casebuilding/bates.json"],
      "resume_safe": true
    },
    {
      "id": "verify-bates-contiguity",
      "needs": ["assign-bates"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/bates_stamper.py", "--verify", "missions/deep-casebuilding/bates.json"],
      "consumes": ["missions/deep-casebuilding/bates.json"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "verify-event-timeline",
      "needs": ["verify-bates-contiguity"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/timestamp_verifier.py", "--events", "missions/deep-casebuilding/events.json", "--out", "missions/deep-casebuilding/timestamp-report.json"],
      "consumes": ["missions/deep-casebuilding/events.json"],
      "produces": ["missions/deep-casebuilding/timestamp-report.json"],
      "resume_safe": true
    },
    {
      "id": "scan-pii",
      "needs": ["verify-event-timeline"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/pii_scrubber.py", "--root", "missions/deep-casebuilding/intake", "--report", "missions/deep-casebuilding/pii-report.json"],
      "consumes": ["missions/deep-casebuilding/intake"],
      "produces": ["missions/deep-casebuilding/pii-report.json"],
      "resume_safe": true
    },
    {
      "id": "emit-master-manifest",
      "needs": ["scan-pii"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/manifest_emitter.py", "--digests", "missions/deep-casebuilding/digests.json", "--bates", "missions/deep-casebuilding/bates.json", "--anomalies", "missions/deep-casebuilding/anomalies.json", "--timestamps", "missions/deep-casebuilding/timestamp-report.json", "--out", "missions/deep-casebuilding/BATES_MANIFEST.json", "--timeline", "missions/deep-casebuilding/00_FORENSIC_MASTER_TIMELINE.json"],
      "consumes": ["missions/deep-casebuilding/digests.json", "missions/deep-casebuilding/bates.json", "missions/deep-casebuilding/anomalies.json", "missions/deep-casebuilding/timestamp-report.json"],
      "produces": ["missions/deep-casebuilding/BATES_MANIFEST.json", "missions/deep-casebuilding/00_FORENSIC_MASTER_TIMELINE.json"],
      "resume_safe": true
    },
    {
      "id": "verify-manifest-chain",
      "needs": ["emit-master-manifest"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/scripts/manifest_emitter.py", "--verify", "missions/deep-casebuilding/BATES_MANIFEST.json"],
      "consumes": ["missions/deep-casebuilding/BATES_MANIFEST.json"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "audit-audio-custody",
      "needs": ["verify-manifest-chain"],
      "command": ["{python}", "skills/audio-forensic-core/scripts/sha256_audit.py", "--root", "missions/deep-casebuilding/audio", "--out", "missions/deep-casebuilding/custody.json"],
      "consumes": ["missions/deep-casebuilding/audio"],
      "produces": ["missions/deep-casebuilding/custody.json"],
      "resume_safe": true
    },
    {
      "id": "compile-sample-transcript",
      "needs": ["audit-audio-custody"],
      "command": ["{python}", "skills/audio-forensic-core/scripts/transcript_formatter.py", "--alignment", "missions/deep-casebuilding/fixtures/alignment.sample.json", "--rules", "skills/audio-forensic-core/resources/court_rules_hi_family.yaml", "--case-number", "1FDV-23-0001009", "--caption", "Barton v. Barton", "--out", "missions/deep-casebuilding/transcripts/sample-transcript.txt", "--verify", "missions/deep-casebuilding/transcript-verify.json"],
      "consumes": ["missions/deep-casebuilding/fixtures/alignment.sample.json", "skills/audio-forensic-core/resources/court_rules_hi_family.yaml"],
      "produces": ["missions/deep-casebuilding/transcripts/sample-transcript.txt", "missions/deep-casebuilding/transcript-verify.json"],
      "resume_safe": true
    },
    {
      "id": "verify-alignment",
      "needs": ["compile-sample-transcript"],
      "command": ["{python}", "skills/audio-forensic-core/scripts/whisperx_align.py", "--verify-alignment", "missions/deep-casebuilding/fixtures/alignment.sample.json", "--out", "missions/deep-casebuilding/alignment-verify.json"],
      "consumes": ["missions/deep-casebuilding/fixtures/alignment.sample.json"],
      "produces": ["missions/deep-casebuilding/alignment-verify.json"],
      "resume_safe": true
    },
    {
      "id": "verify-diarization",
      "needs": ["verify-alignment"],
      "command": ["{python}", "skills/audio-forensic-core/scripts/speaker_diarize.py", "--verify-segments", "missions/deep-casebuilding/fixtures/segments.sample.json", "--out", "missions/deep-casebuilding/diarization-report.json"],
      "consumes": ["missions/deep-casebuilding/fixtures/segments.sample.json"],
      "produces": ["missions/deep-casebuilding/diarization-report.json"],
      "resume_safe": true
    },
    {
      "id": "test-forensic-evidence-chain-core",
      "needs": ["verify-diarization"],
      "command": ["{python}", "skills/forensic-evidence-chain-core/tests/test_forensic_evidence_chain_core.py"],
      "consumes": ["skills/forensic-evidence-chain-core/tests/test_forensic_evidence_chain_core.py"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "test-audio-forensic-core",
      "needs": ["test-forensic-evidence-chain-core"],
      "command": ["{python}", "skills/audio-forensic-core/tests/test_audio_forensic_core.py"],
      "consumes": ["skills/audio-forensic-core/tests/test_audio_forensic_core.py"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "test-epistemic-gate",
      "needs": ["test-audio-forensic-core"],
      "command": ["{python}", "skills/epistemic-gate/tests/test_epistemic_gate.py"],
      "consumes": ["skills/epistemic-gate/tests/test_epistemic_gate.py"],
      "produces": [],
      "resume_safe": false
    },
    {
      "id": "compile-casebuilding-dossier",
      "needs": ["test-epistemic-gate"],
      "command": ["{python}", "-c", "import json,pathlib; base=pathlib.Path('missions/deep-casebuilding'); m=json.load(open(base/'BATES_MANIFEST.json')); t=json.load(open(base/'transcript-verify.json')); a=json.load(open(base/'alignment-verify.json')); d=json.load(open(base/'diarization-report.json')); assert len(m['chain_root_sha256'])==64; assert t['format_compliant']; assert a['aligned']; assert d['valid']; out={'schema_version':1,'chain_root':m['chain_root_sha256'],'transcript_pages':t['pages'],'words_aligned':a['word_count'],'speakers':d['speaker_count'],'status':'dossier_compiled'}; (base/'DEEP_CASEBUILDING_DOSSIER.json').write_text(json.dumps(out,indent=2)+chr(10)); print('deep-casebuilding-dossier-ok')"],
      "consumes": ["missions/deep-casebuilding/BATES_MANIFEST.json", "missions/deep-casebuilding/transcript-verify.json", "missions/deep-casebuilding/alignment-verify.json", "missions/deep-casebuilding/diarization-report.json"],
      "produces": ["missions/deep-casebuilding/DEEP_CASEBUILDING_DOSSIER.json"],
      "resume_safe": true
    }
  ]
}
