{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.example/schemas/branch-inventory.v1.json",
  "title": "GlacierEQ Branch Inventory",
  "type": "object",
  "required": ["schema", "repository", "default_branch", "generated_at", "branches"],
  "properties": {
    "schema": {"const": "glaciereq.branch-inventory.v1"},
    "repository": {"type": "string", "minLength": 3},
    "default_branch": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha", "protected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
          "protected": {"type": "boolean"},
          "head_committed_at": {"type": ["string", "null"]},
          "ahead_by": {"type": ["integer", "null"], "minimum": 0},
          "behind_by": {"type": ["integer", "null"], "minimum": 0},
          "compare_status": {"type": ["string", "null"]},
          "open_prs": {"type": "array"},
          "merged_prs": {"type": "array"},
          "closed_unmerged_prs": {"type": "array"},
          "changed_files": {"type": "array", "items": {"type": "string"}},
          "evidence_errors": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
