{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.example/schemas/branch-admission-request.v1.json",
  "title": "GlacierEQ Branch Admission Request",
  "type": "object",
  "required": ["schema", "requested_branch", "workstream_id"],
  "properties": {
    "schema": {"const": "glaciereq.branch-admission-request.v1"},
    "requested_branch": {"type": "string", "minLength": 1},
    "workstream_id": {"type": "string", "minLength": 1},
    "continuation_of": {"type": ["string", "null"], "minLength": 1},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workstream_id", "branch"],
        "properties": {
          "workstream_id": {"type": "string", "minLength": 1},
          "branch": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
