{
  "schema_version": 1,
  "id": "ship-cloud",
  "display_name": "Ship and Cloud",
  "description": "Web/backend/cloud packaging that stops at a deployment approval packet.",
  "family": "ship-cloud",
  "span": [
    "inception",
    "readiness",
    "recon",
    "design",
    "build",
    "verify",
    "package",
    "deploy-gate",
    "handoff",
    "evolve"
  ],
  "mega_roots": [
    "apex-web-build-system",
    "apex-vercel-web-foundry",
    "apex-backend-infrastructure-engine",
    "apex-secure-cloud-foundry"
  ],
  "required_combos": [
    "long-horizon-core",
    "capability-readiness",
    "pipeline-orchestration"
  ],
  "deploy_mode": "approval_packet_only",
  "max_parallel": 1,
  "manifest": "missions/ship-cloud/pipeline-execution-manifest.json",
  "stages": [
    {
      "id": "inception",
      "phase": "inception",
      "needs": [],
      "command": [
        "{python}",
        "scripts/deep_work_stage.py",
        "--root",
        "{workspace}",
        "--pipeline-id",
        "ship-cloud",
        "--family",
        "ship-cloud",
        "--stage",
        "inception"
      ],
      "consumes": [],
      "produces": [
        "missions/ship-cloud/MISSION.md",
        "missions/ship-cloud/ROADMAP.md",
        "missions/ship-cloud/CONTEXT.md",
        "missions/ship-cloud/inception.json"
      ],
      "resume_safe": true,
      "approval_required": false,
      "timeout_seconds": 120
