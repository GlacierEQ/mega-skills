{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/mega-skills/schemas/mega-skill-pyramid.schema.json",
  "title": "GlacierEQ Recursive Mega-Skill DAG Projection",
  "description": "Normalized generated graph for recursively composable proper Skills. Human views may render each Mega root as a pyramid; machine identity is a typed DAG.",
  "type": "object",
  "required": ["schema_version","ontology","identity_rule","source_registries","contract_paths","expansion_contract","counts","mega_roots","compound_nodes","leaf_keys","shared_node_lineage"],
  "additionalProperties": false,
  "$defs": {
    "typedKey": {"type":"string","pattern":"^(atomic|compound|mega|external):[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "compoundKey": {"type":"string","pattern":"^compound:[a-z0-9]+(?:-[a-z0-9]+)*$"}
  },
  "properties": {
    "schema_version": {"const":2},
    "ontology": {"const":"recursive-proper-skill-pyramid"},
    "identity_rule": {"type":"string","minLength":20},
    "source_registries": {"type":"object"},
    "contract_paths": {"type":"object"},
    "expansion_contract": {"type":"object"},
    "counts": {"type":"object","required":["atomic_skills","compound_skills","mega_skills","mega_pyramids","unresolved_owned_references","compound_cycles"]},
    "mega_roots": {"type":"array","minItems":1,"items":{"type":"object","required":["key","id","required_compound_keys","conditional_compound_keys"],"properties":{"key":{"type":"string","pattern":"^mega:[a-z0-9]+(?:-[a-z0-9]+)*$"},"id":{"type":"string"},"required_compound_keys":{"type":"array","items":{"$ref":"#/$defs/compoundKey"}},"conditional_compound_keys":{"type":"array","items":{"$ref":"#/$defs/compoundKey"}}}}},
    "compound_nodes": {"type":"array","minItems":1,"items":{"type":"object","required":["key","id","members"],"properties":{"key":{"$ref":"#/$defs/compoundKey"},"id":{"type":"string"},"members":{"type":"array","items":{"type":"object","required":["key","kind","required","role"],"properties":{"key":{"$ref":"#/$defs/typedKey"},"kind":{"enum":["skill","compound-skill","external-skill"]},"required":{"type":"boolean"},"role":{"type":["string","null"]}}}}}}},
    "leaf_keys": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(atomic|external):[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "shared_node_lineage": {"type":"array","items":{"type":"object","required":["key","parent_keys"],"properties":{"key":{"$ref":"#/$defs/typedKey"},"parent_keys":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/typedKey"}}}}}
  }
}
